# Superseded scene entry points; keep only the final hall variants.
/scenes/shatterseal_asset_preview.json
/scenes/shatterseal_moonlit_hall.json
/scenes/shatterseal_moonlit_hall_preview.json
/scenes/shatterseal_moonlit_hall_detail.json

# The final hall still uses these four original architecture assets.
/scenes/models/moonlit_hall/*
!/scenes/models/moonlit_hall/stone.obj
!/scenes/models/moonlit_hall/trim.obj
!/scenes/models/moonlit_hall/floor_stone.png
!/scenes/models/moonlit_hall/wall_stone.png

# Keep the three weapon parts, their MTL declarations, and the used color map.
# Unused overlays, merged duplicates, and other game maps stay local.
/scenes/models/shatterseal_drakesnest/*
!/scenes/models/shatterseal_drakesnest/parts/
!/scenes/models/shatterseal_drakesnest/shatterseal.mtl
!/scenes/models/shatterseal_drakesnest/textures/
/scenes/models/shatterseal_drakesnest/textures/*
!/scenes/models/shatterseal_drakesnest/textures/baked/
/scenes/models/shatterseal_drakesnest/textures/baked/*
!/scenes/models/shatterseal_drakesnest/textures/baked/Metal_basecolor.png
