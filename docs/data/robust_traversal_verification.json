  "implementation": {
    "triangle": "Two-sided ray-aligned projected edges. Float inputs are promoted to double before subtraction; edge products are independently rounded to preserve reversed-edge antisymmetry. No fast-math; the project near-hit threshold remains 1e-5.",
    "attributes": "UV/shading-normal weights are evaluated by the same robust triangle routine on the winning triangle, rather than reconstructed from rounded float t.",
    "references": [
      "https://pbr-book.org/4ed/Shapes/Triangle_Meshes",
      "https://jcgt.org/published/0002/01/05/"
    ],
    "scope": "Improved numerical robustness on stored float geometry; not an adaptive exact-arithmetic predicate or a proof for all possible floating-point inputs.",
    "traversal": [
      "Cache direction reciprocals per mesh query; conservative endpoint widening and reference fallback for zero/tiny/non-finite directions.",
      "CPU validation before upload permits skipping repeated topology/index/bounds validation inside the immutable GPU tree.",
      "Keep the active near child in registers; stack holds deferred far siblings. Logical capacity remains 33, including the active node; overflow still falls back to a triangle scan."
    ],
    "switches": {
      "reference": "--reference-traversal",
      "cached_with_structural_checks": "--checked-traversal",
      "optimized": "default"
    },
    "unchanged": "Scene geometry, materials, textures, camera, RNG and estimator are unchanged. Tree policy is still SAH, 16 bins, leaf cap 2."
